# Environment variables — copy to `.env.local` (local dev) and `.env.production` (build/deploy).
# Never commit real values. Only commit placeholders via this `.env.example`.

# Local development only. Obtain a token from the App Check debug provider at runtime
# (Security > App Check > Apps > Manage debug tokens) and register it in the console.
# VITE_APPCHECK_DEBUG_TOKEN=<paste your debug token>

# Production only. Your reCAPTCHA Enterprise (SCORE) SITE KEY. This key is public by
# design (it ships in the client bundle); keep the reCAPTCHA secret, not this, protected.
# Register this same key in Firebase console: Security > App Check > Apps > voyageai-web > Manage keys.
# VITE_RECAPTCHA_SITE_KEY=<your reCAPTCHA enterprise site key>

# Firebase web app config. These values are public-by-design (they ship in the client
# bundle and appear in devtools/network — this is how the Firebase web SDK works). They
# are NOT secrets; real protection comes from Firestore rules, Auth, and App Check.
# Get them from: Project settings > Your apps > the web app "voyageai-web".
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=my-first-project-55f9a.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=my-first-project-55f9a
# VITE_FIREBASE_STORAGE_BUCKET=my-first-project-55f9a.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=190696717811
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=G-SVYBME5M48

# STEP 41 — REAL EXTERNAL DISCOVERY PROVIDER (Amadeus Self-Service hotel search).
# SERVER-SIDE ONLY. These keys are NEVER read by the browser bundle and must
# never be prefixed with VITE_ (Vite embeds VITE_* vars into the client bundle,
# which would ship the credentials to every visitor). This browser-only app has
# no server-side execution boundary to hold them, so the client always reports a
# first-class `not-configured` / `credentials-missing` outcome and never calls
# the provider. A future server-side execution layer reads them via
# `loadAmadeusConfigFromEnv` and passes the config in.
# REAL_DISCOVERY_ATTEMPT_ENABLED=false   # non-secret master switch (default off)
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=
# AMADEUS_ENVIRONMENT=test               # `test` (sandbox) or `production`

# STEP 42 — SECURE SERVER-SIDE EXTERNAL DISCOVERY BOUNDARY (Firebase Functions v2).
# The Functions host at `functions/` (rewritten from `/api/**`) reads the
# Amadeus credentials above from the Functions RUNTIME configuration
# (server-side only; the browser never sees them). The safe default stays
# `REAL_DISCOVERY_ATTEMPT_ENABLED=false` — the server fails closed (501/503)
# unless the deployment explicitly enables it with credentials present.
#
# Browser-side capability wiring (NON-SECRET public values). These may use the
# VITE_ prefix because they carry no credential — but the Amadeus keys above
# must NEVER be prefixed with VITE_.
# VITE_REAL_DISCOVERY_SERVER_ENABLED=false    # non-secret capability flag (default off)
# VITE_REAL_DISCOVERY_SERVER_ENDPOINT=/api/real-discovery

# STEP 44 — GOOGLE PLACES DISCOVERY PROVIDER (read-only place discovery foundation).
# SERVER-SIDE ONLY. These values are NEVER read by the browser bundle and must
# never be prefixed with VITE_ (Vite embeds VITE_* vars into the client bundle,
# which would ship the key to every visitor). The provider stays disabled by
# default; missing/empty credentials fail safely as a first-class
# `credentials-missing` gate and no live Google request ever runs without an
# explicitly-enabled deployment. A future server-side execution layer reads
# them via `loadGooglePlacesConfigFromEnv`.
# GOOGLE_PLACES_ENABLED=false                # non-secret master switch (default off)
# GOOGLE_PLACES_API_KEY=

# STEP 47 — GOOGLE ROUTES COMPUTE ROUTES PROVIDER (read-only origin→destination→route).
# SERVER-SIDE ONLY. These values are NEVER read by the browser bundle and must
# never be prefixed with VITE_ (Vite embeds VITE_* vars into the client bundle,
# which would ship the key to every visitor). The provider stays disabled by
# default; missing/empty credentials fail safely as a first-class
# `credentials-missing` gate and no live Google request ever runs without an
# explicitly-enabled deployment. Note the Routes capability flag is INDEPENDENT
# of the Google Places flag above — the app can disable Routes separately.
# A future server-side execution layer reads them via `loadGoogleRoutesConfigFromEnv`.
# GOOGLE_ROUTES_ENABLED=false                # non-secret master switch (default off)
# GOOGLE_ROUTES_API_KEY=