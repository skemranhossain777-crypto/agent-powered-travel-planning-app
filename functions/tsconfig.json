{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "..",
    "outDir": "lib",
    "lib": ["ES2020"]
  },
  "include": [
    "src",
    "../src/services/serverBoundary/**/*.ts",
    "../src/services/realDiscovery/**/*.ts",
    "../src/services/realExecution/**/*.ts",
    "../src/services/tripExecution/**/*.ts",
    "../src/domain/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "../src/services/tripExecution/firestoreTripExecutionRecordRepository.ts"
  ]
}
